# Copy to `.env` (gitignored) and adjust as needed.

POSTGRES_DB=taskdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Controls which application-{profile}.yml is active. Try switching this
# to "dev" and re-running `docker compose up --build` to see the
# difference: verbose SQL logging turns on, ddl-auto goes back to
# "update", and /actuator/health starts showing full component details.
SPRING_PROFILES_ACTIVE=prod
