          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"400 Bad Request - Type Mismatch\", function() {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errorCode).to.equal(\"TYPE_MISMATCH\");",
                  "    pm.expect(body.message).to.include(\"abc\");",
                  "    pm.expect(body.message).to.include(\"Long\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
