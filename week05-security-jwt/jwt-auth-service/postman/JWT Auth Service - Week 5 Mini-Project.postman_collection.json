  "item": [
    {
      "name": "1. Public Endpoints (No Auth Required)",
      "item": [
        {
          "name": "{{baseUrl}}{{apiVersion}}/auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Registration successful\", function() {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.be.a(\"number\");",
                  "    pm.expect(body.email).to.equal(\"test@authservice.com\");",
                  "    pm.expect(body.role).to.equal(\"USER\");",
                  "    pm.expect(body).to.not.have.property(\"password\");",
                  "    pm.environment.set(\"userId\", body.id);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"{{newUserEmail}}\",\n    \"password\": \"{{newUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{apiVersion}}/auth/register",
              "host": [
                "{{baseUrl}}{{apiVersion}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "{{baseUrl}}{{apiVersion}}/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Admin login successful\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.accessToken).to.be.a(\"string\");",
                  "    pm.expect(body.accessToken.split(\".\").length).to.equal(3);",
                  "    pm.expect(body.refreshToken).to.be.a(\"string\");",
                  "    pm.expect(body.role).to.equal(\"ADMIN\");",
                  "    pm.environment.set(\"accessToken\", body.accessToken);",
                  "    pm.environment.set(\"refreshToken\", body.refreshToken);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{apiVersion}}/auth/login",
              "host": [
                "{{baseUrl}}{{apiVersion}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
