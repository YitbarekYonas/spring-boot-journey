    {
      "name": "3. Multiple Violation Tests",
      "item": [
        {
          "name": "{{baseUrl}}{{apiVersion}}/auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Multiple violations reported together\", function() {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.fieldErrors.length).to.equal(3);",
                  "    ",
                  "    const messages = body.fieldErrors.map(fe => fe.message);",
                  "    pm.expect(messages).to.include(\"Name is required\");",
                  "    pm.expect(messages).to.include(\"Email must be a valid email address\");",
                  "    pm.expect(messages).to.include(\"Password must be between 8 and 72 characters\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
