<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0</version>
    </parent>
    <groupId>com.JavaBackEnd</groupId>
    <artifactId>spring-boot-journey-week7-day4</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-boot-journey-week7-day4</name>
    <description>Week 7 Day 4 — @DataJpaTest: Test the repository layer</description>
    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            H2 is used as BOTH the runtime datasource (see application.yml)
            AND the embedded database that @DataJpaTest auto-configures for
            tests. Scope is intentionally NOT "test" here so the app can also
            run standalone without an external DB — swap to "test" scope once
            you point this at a real Postgres/MySQL instance.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <!--
            spring-boot-starter-test includes JUnit 5, AssertJ, and
            (via spring-boot-starter-data-jpa on the classpath)
            @DataJpaTest / TestEntityManager auto-configuration.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
