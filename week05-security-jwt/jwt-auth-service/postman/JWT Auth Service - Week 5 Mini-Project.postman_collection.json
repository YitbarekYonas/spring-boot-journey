          "name": "{{baseUrl}}{{apiVersion}}/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"User login successful\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.equal(\"USER\");",
                  "    pm.environment.set(\"userAccessToken\", body.accessToken);",
                  "    pm.environment.set(\"userRefreshToken\", body.refreshToken);",
                  "});"
