    {
      "name": "2. Error Tests (400 Series)",
      "item": [
        {
          "name": "{{baseUrl}}{{apiVersion}}/books/{{nonExistentId}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"404 Not Found\", function() {",
                  "    pm.response.to.have.status(404);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errorCode).to.equal(\"BOOK_NOT_FOUND\");",
                  "    pm.expect(body.message).to.include(\"99999\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiVersion}}/books/{{nonExistentId}}",
              "host": [
                "{{baseUrl}}{{apiVersion}}"
              ],
              "path": [
                "books",
                "{{nonExistentId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "{{baseUrl}}{{apiVersion}}/books",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"409 Conflict - Duplicate ISBN\", function() {",
                  "    pm.response.to.have.status(409);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errorCode).to.equal(\"DUPLICATE_BOOK\");",
                  "    pm.expect(body.message).to.include(\"978-0132350884\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
