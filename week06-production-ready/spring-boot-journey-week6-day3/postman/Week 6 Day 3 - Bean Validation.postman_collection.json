  "item": [
    {
      "name": "1. Success Tests (Valid Data)",
      "item": [
        {
          "name": "{{baseUrl}}{{apiVersion}}/auth/register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\",\n    \"password\": \"ValidPass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{apiVersion}}/auth/register",
              "host": [
                "{{baseUrl}}{{apiVersion}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "{{baseUrl}}{{apiVersion}}/auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Validation returns 400 with fieldErrors\", function() {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errorCode).to.equal(\"VALIDATION_FAILED\");",
                  "    pm.expect(body.fieldErrors).to.be.an(\"array\");",
                  "    pm.expect(body.fieldErrors.length).to.equal(3);",
                  "    ",
                  "    // Check specific field errors",
                  "    const fieldNames = body.fieldErrors.map(fe => fe.field);",
                  "    pm.expect(fieldNames).to.include(\"name\");",
                  "    pm.expect(fieldNames).to.include(\"email\");",
                  "    pm.expect(fieldNames).to.include(\"password\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"\",\n    \"email\": \"\",\n    \"password\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{apiVersion}}/auth/register",
              "host": [
                "{{baseUrl}}{{apiVersion}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        }
      ]
    },
