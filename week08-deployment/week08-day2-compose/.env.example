# Copy this file to `.env` (which is gitignored — see .gitignore) and adjust
# values as needed. docker-compose.yml reads `.env` automatically.
#
# Never commit a real `.env` file with real credentials — this is exactly
# the "hardcoding secrets" mistake the roadmap flags for Week 8. Committing
# only this .example file (with obviously-fake placeholder values) is the
# safe pattern.

POSTGRES_DB=taskdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
